<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Does this app/SDK use data for tracking? No. -->
    <key>NSPrivacyTracking</key>
    <false/>

    <!-- Domains used for tracking. None. -->
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- Data types collected. RecallThat stores everything on-device only.
         No data is linked to identity or used for tracking. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!-- Required Reason APIs used by this app. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!--
            NSUserDefaults — used to persist the "hasCompletedOnboarding" flag.
            Reason CA92.1: read/write information used solely to manage app functionality on device.
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
