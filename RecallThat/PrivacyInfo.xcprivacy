<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Does this app/SDK use data for tracking? No. -->
    <key>NSPrivacyTracking</key>
    <false/>

    <!-- Domains used for tracking. None. -->
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- Text extracted from screenshots may be sent to OpenAI to power
         semantic search and AI-generated answers. Not linked to identity,
         not used for tracking. Screenshots/photos/thumbnails themselves
         are never collected — they stay on-device. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>

    <!-- Required Reason APIs used by this app. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!--
            NSUserDefaults — used to persist the "hasCompletedOnboarding" flag.
            Reason CA92.1: read/write information used solely to manage app functionality on device.
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
