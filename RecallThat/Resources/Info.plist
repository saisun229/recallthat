<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>RecallThat</string>
    <key>CFBundleName</key>
    <string>RecallThat</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- Encryption — app uses only standard iOS HTTPS/TLS, no custom crypto -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- Device orientation — portrait only -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- iOS 17+ requires arm64; armv7 capability removed (would exclude valid devices) -->
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>

    <!-- Photos access — required for screenshot indexing -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>RecallThat reads your screenshots to extract and index their text. Everything stays on your device — nothing is uploaded.</string>

    <!-- Required to delete original screenshots after they are indexed -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>RecallThat needs this permission to delete the original screenshot from your Photos library when you choose Safe Delete.</string>

    <!-- OpenAI API key — injected at build time via OPENAI_API_KEY Xcode Cloud env var; never committed to source -->
    <key>OpenAIAPIKey</key>
    <string>$(OPENAI_API_KEY)</string>

    <!-- Launch screen — SwiftUI handles it; empty dict is correct -->
    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>
